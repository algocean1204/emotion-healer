# cp env.example .env 후 값 입력. .env 는 커밋 제외.
# 실제 값 입력 금지 — 이 파일은 커밋 대상.

# --- LLM 키 -----------------------------------------------------------------
# 키는 서버 프로세스 환경에만 주입. 엔드포인트 반환 금지.
# 사용자별 GPT/OpenAI 키는 받지 않음 — 서버 키 하나만 사용.
#
# 로컬: 둘 다 비우고 호스트 Codex 로그인(OAuth)으로 답변 모델 실행.
# 배포: ANTHROPIC_API_KEY 사용 — 컨테이너에는 Codex 로그인 없음.
ALGOCEANCODEXOAUTH_API=
ANTHROPIC_API_KEY=

# --- 인증 -------------------------------------------------------------------
# 아는 사람만 들어오게 하는 초대 코드. 서비스의 실질적인 접근 경계.
# 파일(app/auth/healer_auth.json)보다 이 값이 우선하며, 둘 다 비면 로그인 차단.
# 숫자 4자리 제한 없음 — 긴 값 권장.
HEALER_INVITE_CODE=

# HTTPS 배포 시 1 사용. 활성화 후 http 토큰 쿠키 전송 차단.
HEALER_COOKIE_SECURE=

# API가 붙을 주소. 비우면 127.0.0.1 이라 같은 Wi-Fi에서도 안 보임.
# 도커 화면(:8080) 사용 시에만 0.0.0.0 으로 개방.
HEALER_HOST=

# --- 사용자 관리 DB ---------------------------------------------------------
POSTGRES_PASSWORD=
POSTGRES_DSN=postgresql://healer:CHANGE_ME@localhost:5432/healer

# --- 온톨로지 그래프 DB -----------------------------------------------------
# /data 볼륨 최초 생성 시에만 반영. 이후 변경 시 볼륨 재생성 필요.
NEO4J_PASSWORD=
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j

# --- 프론트 ------------------------------------------------------------------
# web 컨테이너의 /api 전달 대상. 백엔드는 호스트에서 실행.
API_UPSTREAM=http://host.docker.internal:8000
