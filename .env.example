# Local use: leave this file alone. The Codex CLI login covers auth.
#   npm install -g @openai/codex && codex login

# Deployed use: switch to API-key auth.
# ALGOCEANCODEXOAUTH_AUTH=api_key
# ALGOCEANCODEXOAUTH_API=sk-...

# Model override (defaults to gpt-5.5 for oauth, gpt-4o for api_key)
# EMOTION_HEALER_MODEL=gpt-5.5
